rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return verified() && request.auth.token.email == 'david35e@gmail.com';
    }
    function isText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    // פוסטים בקהילה: קריאה לכולם, כתיבה רק למשתמש מאומת ובשמו שלו
    match /posts/{id} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'title', 'body', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'authorName', 'title', 'body', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isText(request.resource.data.authorName, 60)
        && isText(request.resource.data.title, 120)
        && isText(request.resource.data.body, 4000)
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // דיווח על פוסט: כל משתמש מחובר, רק מנהל קורא
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['postId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isText(request.resource.data.postId, 128)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // תוכניות טיול: פרטיות לבעלים
    match /plans/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'interest', 'month', 'days', 'destinationIds', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'interest', 'month', 'days', 'destinationIds', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isText(request.resource.data.interest, 30)
        && request.resource.data.month is int
        && request.resource.data.days is int
        && request.resource.data.destinationIds is list
        && request.resource.data.destinationIds.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // פניות מהאתר: כל אחד יכול לשלוח, רק מנהל קורא ומטפל
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'consent', 'handled', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'consent', 'handled', 'createdAt'])
        && isText(request.resource.data.name, 80)
        && isText(request.resource.data.email, 200)
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && isText(request.resource.data.message, 3000)
        && request.resource.data.consent == true
        && request.resource.data.handled == false
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled'])
        && request.resource.data.handled is bool;
    }

    // לחיצות על קישורי שותפים: ספירה אנונימית, רק מנהל קורא
    match /clicks/{id} {
      allow create: if request.resource.data.keys().hasOnly(['partner', 'page', 'createdAt'])
        && request.resource.data.keys().hasAll(['partner', 'page', 'createdAt'])
        && isText(request.resource.data.partner, 30)
        && isText(request.resource.data.page, 120)
        && request.resource.data.page.matches('^/.*')
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
