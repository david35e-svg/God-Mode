{
  "collections": [
    {
      "path": "users",
      "description": "User profiles and progression state",
      "type": "collection",
      "fields": [
        { "name": "name", "type": "string", "description": "Display name" },
        { "name": "level", "type": "number", "description": "Gamer level" },
        { "name": "xp", "type": "number", "description": "Experience points" },
        { "name": "nextLevelXp", "type": "number", "description": "Next level threshold" },
        { "name": "characterClass", "type": "string", "description": "Character class" },
        { "name": "coins", "type": "number", "description": "Coins balance" },
        { "name": "language", "type": "string", "description": "Selected interface language" },
        { "name": "updatedAt", "type": "timestamp", "description": "Last updated" }
      ]
    },
    {
      "path": "inquiries",
      "description": "Travel and conference inquiry submissions",
      "type": "collection",
      "fields": [
        { "name": "fullName", "type": "string", "description": "Full name" },
        { "name": "email", "type": "string", "description": "Email address" },
        { "name": "phone", "type": "string", "description": "Phone number" },
        { "name": "selectedPkg", "type": "string", "description": "Destination or package of interest" },
        { "name": "travelersCount", "type": "string", "description": "Travelers count" },
        { "name": "language", "type": "string", "description": "Submission language" },
        { "name": "userId", "type": "string", "description": "Submitting user ID" },
        { "name": "createdAt", "type": "timestamp", "description": "Creation timestamp" }
      ]
    },
    {
      "path": "affiliate_providers",
      "description": "Affiliate network and travel inventory providers",
      "type": "collection",
      "fields": [
        { "name": "providerId", "type": "string", "description": "Unique provider identifier" },
        { "name": "providerName", "type": "string", "description": "Display name of provider" },
        { "name": "category", "type": "string", "description": "Category (hotels, flights, activities, carRental, etc.)" },
        { "name": "affiliateId", "type": "string", "description": "Public publisher or partner ID" },
        { "name": "campaignId", "type": "string", "description": "Campaign reference identifier" },
        { "name": "baseUrlTemplate", "type": "string", "description": "URL template with {dest}, {affiliate_id} tokens" },
        { "name": "status", "type": "string", "description": "Active or inactive status" },
        { "name": "websiteUrl", "type": "string", "description": "Provider homepage" },
        { "name": "createdAt", "type": "timestamp", "description": "Creation timestamp" },
        { "name": "updatedAt", "type": "timestamp", "description": "Last update timestamp" }
      ]
    },
    {
      "path": "affiliate_offers",
      "description": "Curated gamer travel offers, passes, and partner deals",
      "type": "collection",
      "fields": [
        { "name": "id", "type": "string", "description": "Offer identifier" },
        { "name": "providerId", "type": "string", "description": "Affiliated provider ID" },
        { "name": "title", "type": "string", "description": "Offer headline" },
        { "name": "description", "type": "string", "description": "Offer description" },
        { "name": "destinationId", "type": "string", "description": "Target destination code or slug" },
        { "name": "destinationName", "type": "string", "description": "Display name of destination" },
        { "name": "category", "type": "string", "description": "Category of travel offer" },
        { "name": "deepLink", "type": "string", "description": "Canonical partner target link" },
        { "name": "price", "type": "string", "description": "Pricing label" },
        { "name": "xpReward", "type": "number", "description": "Gamer experience points granted on discovery" },
        { "name": "active", "type": "boolean", "description": "Whether offer is live" }
      ]
    },
    {
      "path": "affiliate_clicks",
      "description": "Immutable telemetry click stream logging partner outbound clicks",
      "type": "collection",
      "fields": [
        { "name": "clickId", "type": "string", "description": "Cryptographically secure random or UUID click ID" },
        { "name": "uid", "type": "string", "description": "Firebase Auth user UID (or anonymous UID)" },
        { "name": "providerId", "type": "string", "description": "Outbound affiliate provider ID" },
        { "name": "linkId", "type": "string", "description": "Affiliate link ID" },
        { "name": "offerId", "type": "string", "description": "Associated offer ID if applicable" },
        { "name": "destinationId", "type": "string", "description": "Target travel destination" },
        { "name": "category", "type": "string", "description": "Category of offer" },
        { "name": "campaignId", "type": "string", "description": "Campaign tracking identifier" },
        { "name": "sourcePage", "type": "string", "description": "Page or component source" },
        { "name": "targetUrl", "type": "string", "description": "Sanitized outbound affiliate URL" },
        { "name": "userAgent", "type": "string", "description": "Client user agent" },
        { "name": "timestamp", "type": "timestamp", "description": "Server or client timestamp" }
      ]
    },
    {
      "path": "affiliate_conversions",
      "description": "Postback and verified partner booking conversions",
      "type": "collection",
      "fields": [
        { "name": "conversionId", "type": "string", "description": "Unique conversion identifier" },
        { "name": "clickId", "type": "string", "description": "Attributed initial click ID" },
        { "name": "uid", "type": "string", "description": "User UID who earned the conversion" },
        { "name": "providerId", "type": "string", "description": "Affiliate provider" },
        { "name": "bookingValue", "type": "number", "description": "Total purchase or booking amount" },
        { "name": "commissionAmount", "type": "number", "description": "Affiliate commission amount" },
        { "name": "currency", "type": "string", "description": "Currency code (USD, EUR, etc.)" },
        { "name": "status", "type": "string", "description": "pending, approved, or rejected" },
        { "name": "createdAt", "type": "timestamp", "description": "Conversion timestamp" }
      ]
    },
    {
      "path": "trips",
      "description": "User created and saved gamer travel itineraries",
      "type": "collection",
      "fields": [
        { "name": "tripId", "type": "string", "description": "Unique trip ID" },
        { "name": "uid", "type": "string", "description": "Firebase Auth User ID" },
        { "name": "title", "type": "string", "description": "Trip title" },
        { "name": "eventId", "type": "string", "description": "Target gaming event ID" },
        { "name": "eventName", "type": "string", "description": "Target gaming event title" },
        { "name": "destinationId", "type": "string", "description": "Destination slug" },
        { "name": "destinationName", "type": "string", "description": "Destination display name" },
        { "name": "originCity", "type": "string", "description": "Departure city or airport" },
        { "name": "startDate", "type": "string", "description": "Travel start date" },
        { "name": "endDate", "type": "string", "description": "Travel end date" },
        { "name": "durationDays", "type": "number", "description": "Duration in days" },
        { "name": "travelersCount", "type": "number", "description": "Number of travelers" },
        { "name": "budgetTier", "type": "string", "description": "Economy, Balanced, or VIP" },
        { "name": "interests", "type": "array", "description": "Gamer interest tags" },
        { "name": "itinerary", "type": "array", "description": "Day by day itinerary items" },
        { "name": "costBreakdown", "type": "map", "description": "Estimated cost breakdown" },
        { "name": "affiliateLinks", "type": "array", "description": "Affiliate booking links" },
        { "name": "createdAt", "type": "timestamp", "description": "Creation timestamp" }
      ]
    },
    {
      "path": "event_crews",
      "description": "Gamers flying to gaming events (Who is going)",
      "type": "collection",
      "fields": [
        { "name": "id", "type": "string", "description": "Crew member record ID" },
        { "name": "eventId", "type": "string", "description": "Gaming event ID" },
        { "name": "eventTitle", "type": "string", "description": "Event display name" },
        { "name": "uid", "type": "string", "description": "Firebase Auth UID" },
        { "name": "displayName", "type": "string", "description": "Gamer handle or name" },
        { "name": "departureCity", "type": "string", "description": "City flying from" },
        { "name": "travelDates", "type": "string", "description": "Planned travel dates" },
        { "name": "travelStyle", "type": "string", "description": "Travel style" },
        { "name": "bio", "type": "string", "description": "Gamer bio & squad search notes" },
        { "name": "createdAt", "type": "timestamp", "description": "Registration timestamp" }
      ]
    },
    {
      "path": "community_posts",
      "description": "Community forum and meetup coordination posts",
      "type": "collection",
      "fields": [
        { "name": "id", "type": "string", "description": "Post ID" },
        { "name": "author", "type": "string", "description": "Author handle" },
        { "name": "authorUid", "type": "string", "description": "Author UID" },
        { "name": "avatar", "type": "string", "description": "Avatar image URL" },
        { "name": "destination", "type": "string", "description": "Destination or city" },
        { "name": "eventId", "type": "string", "description": "Related event ID" },
        { "name": "content", "type": "string", "description": "Post text content" },
        { "name": "category", "type": "string", "description": "meetup, tips, shopping, general" },
        { "name": "likes", "type": "number", "description": "Likes counter" },
        { "name": "createdAt", "type": "timestamp", "description": "Post timestamp" }
      ]
    }
  ]
}
